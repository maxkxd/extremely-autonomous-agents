{
  "manifest_version": 3,
  "name": "EXTREMELY Autonomous Agents",
  "short_name": "EXTREMELY",
  "version": "0.2.0",
  "description": "Lets your EXTREMELY agents use this browser: they work in their own collapsed tab groups and hand you pages to finish.",
  "minimum_chrome_version": "125",
  "key": "",
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "cookies",
    "storage",
    "downloads",
    "webNavigation",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "EXTREMELY Autonomous Agents",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}

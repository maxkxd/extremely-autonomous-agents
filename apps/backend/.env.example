# Copy to .env (gitignored) for local development. Never commit .env or paste these values anywhere else.

# Clerk: Dashboard -> Configure -> API keys.
CLERK_SECRET_KEY=
# Clerk: the "JWKS URL" on the same page, e.g. https://<your-app>.clerk.accounts.dev/.well-known/jwks.json
CLERK_JWKS_URL=
# Clerk: the "Frontend API URL" on the same page, e.g. https://<your-app>.clerk.accounts.dev
CLERK_ISSUER=

# From `npm run keygen`. Left empty locally, a key is made each start (fine for development).
ORG_TOKEN_PRIVATE_KEY=

# Where this backend is reached; the issuer in org tokens. Defaults to http://localhost:5180.
PUBLIC_URL=

# Railway's Postgres. Left empty, PGlite (Postgres inside Node) is used: in memory, or kept in PGLITE_DIR.
DATABASE_URL=
PGLITE_DIR=.pglite

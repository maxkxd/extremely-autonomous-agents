{
  "name": "@eaa/electron",
  "productName": "Extremely Autonomous Agents",
  "private": true,
  "version": "0.2.0",
  "description": "Extremely Autonomous Agents for your desktop",
  "license": "AGPL-3.0-only",
  "author": "World Asset Register",
  "main": "main.cjs",
  "scripts": {
    "stage": "node scripts/stage.cjs",
    "start": "electron .",
    "dist": "node scripts/stage.cjs && electron-builder --win --publish never",
    "dist:linux": "node scripts/stage.cjs && electron-builder --linux --publish never",
    "dist:mac": "node scripts/stage.cjs && electron-builder --mac --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.10"
  },
  "devDependencies": {
    "electron": "43.8.0",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "agency.extremely.desktop",
    "productName": "Extremely Autonomous Agents",
    "executableName": "ExtremelyAutonomousAgents",
    "directories": {
      "output": "dist"
    },
    "afterPack": "scripts/after-pack.cjs",
    "files": [
      "main.cjs",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/stage/server",
        "to": "server"
      },
      {
        "from": "build/stage/ui",
        "to": "ui"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "runAfterFinish": true,
      "artifactName": "Extremely-Autonomous-Agents-Setup.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "artifactName": "Extremely-Autonomous-Agents-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "Extremely-Autonomous-Agents-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Utility",
      "synopsis": "Extremely Autonomous Agents for your desktop",
      "maintainer": "World Asset Register",
      "artifactName": "Extremely-Autonomous-Agents.${ext}"
    },
    "deb": {
      "packageName": "extremely-autonomous-agents"
    },
    "appx": {
      "identityName": "10399WorldAssetRegister.ExtremelyAutonomousAgents",
      "publisher": "CN=5C0EAB61-D000-441D-86C7-C50C5D95CAA9",
      "publisherDisplayName": "World Asset Register Pty Ltd",
      "applicationId": "ExtremelyAutonomousAgents",
      "displayName": "Extremely Autonomous Agents",
      "backgroundColor": "#141414",
      "languages": [
        "en-US"
      ],
      "minVersion": "10.0.17763.0",
      "maxVersionTested": "10.0.26100.0",
      "customExtensionsPath": "build/appx-extensions.xml",
      "artifactName": "Extremely-Autonomous-Agents-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "maxkxd",
        "repo": "extremely-autonomous-agents",
        "releaseType": "draft"
      }
    ],
    "electronLanguages": [
      "en-US"
    ],
    "compression": "maximum"
  },
  "homepage": "https://extremely.agency"
}

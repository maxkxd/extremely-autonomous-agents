{
  "name": "@eaa/electron",
  "productName": "Extremely Autonomous Agents",
  "private": true,
  "version": "0.2.0",
  "description": "Extremely Autonomous Agents for your desktop",
  "license": "AGPL-3.0-only",
  "author": "World Asset Register",
  "main": "main.cjs",
  "scripts": {
    "stage": "node scripts/stage.cjs",
    "start": "electron .",
    "dist": "node scripts/stage.cjs && electron-builder --win --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.10"
  },
  "devDependencies": {
    "electron": "43.8.0",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "agency.extremely.desktop",
    "productName": "Extremely Autonomous Agents",
    "executableName": "ExtremelyAutonomousAgents",
    "directories": {
      "output": "dist"
    },
    "afterPack": "scripts/after-pack.cjs",
    "files": [
      "main.cjs",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/stage/server",
        "to": "server"
      },
      {
        "from": "build/stage/ui",
        "to": "ui"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "runAfterFinish": true,
      "artifactName": "Extremely-Autonomous-Agents-Setup.${ext}"
    },
    "appx": {
      "identityName": "WorldAssetRegister.ExtremelyAutonomousAgents",
      "publisher": "CN=00000000-0000-0000-0000-000000000000",
      "publisherDisplayName": "World Asset Register",
      "applicationId": "ExtremelyAutonomousAgents",
      "displayName": "Extremely Autonomous Agents",
      "backgroundColor": "#141414",
      "languages": ["en-US"],
      "minVersion": "10.0.17763.0",
      "maxVersionTested": "10.0.26100.0",
      "customExtensionsPath": "build/appx-extensions.xml",
      "artifactName": "Extremely-Autonomous-Agents-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "maxkxd",
        "repo": "extremely-autonomous-agents",
        "releaseType": "draft"
      }
    ]
  }
}

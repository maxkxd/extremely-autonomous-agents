# Copy to .env.local (gitignored by Vite's *.local) for the app's sign-in. Both are public values.

# Clerk -> API keys -> Publishable key. Left empty, the app uses our backend's
# development sign-in (any email, no code), which only works when the backend has no Clerk set up.
VITE_CLERK_PUBLISHABLE_KEY=

# Our backend (apps/backend). Defaults to http://localhost:5180.
VITE_EAA_BACKEND_URL=
